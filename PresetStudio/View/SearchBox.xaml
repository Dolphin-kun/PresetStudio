<UserControl x:Class="PresetStudio.View.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ps="clr-namespace:PresetStudio"
             x:Name="Root"
             Width="140"
             Height="22">
    <Grid>
        <TextBox x:Name="InputBox"
                 VerticalContentAlignment="Center"
                 Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InputBox_KeyDown" />
        <TextBlock Text="{x:Static ps:Texts.Search}"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Text, ElementName=InputBox}" Value="" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=InputBox}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
