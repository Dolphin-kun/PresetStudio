<Window x:Class="PresetStudio.View.MessageWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:YukkuriMovieMaker.Resources.Localization;assembly=YukkuriMovieMaker.Plugin"
        Title="PresetStudio"
        MinWidth="300"
        MaxWidth="520"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" />
    </Window.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Margin="8,10,8,10"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Width="100"
                    Content="{x:Static loc:Texts.OKButtonContent}"
                    Click="OkButton_Click" />
            <Button x:Name="CancelButton"
                    Width="100"
                    Content="{x:Static loc:Texts.CancelButtonContent}"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
