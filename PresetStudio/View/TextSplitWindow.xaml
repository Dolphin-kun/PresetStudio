<Window x:Class="PresetStudio.View.TextSplitWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ps="clr-namespace:PresetStudio"
        xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
        xmlns:loc="clr-namespace:YukkuriMovieMaker.Resources.Localization;assembly=YukkuriMovieMaker.Plugin"
        Title="{x:Static ps:Texts.SplitText}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" />
    </Window.Style>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ToolBarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Modes}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Mode"
                      SelectedValue="{Binding Mode}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,4,0"
                       VerticalAlignment="Center"
                       Text="{x:Static ps:Texts.Interval}"
                       ToolTip="{x:Static ps:Texts.SplitIntervalToolTip}" />
            <TextBox Grid.Column="2"
                     VerticalContentAlignment="Center"
                     ToolTip="{x:Static ps:Texts.SplitIntervalToolTip}"
                     Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <ToolBarTray Grid.Row="1" Margin="0,4,0,0">
            <ToolBar Height="26" Padding="0">
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding IsBoundaryMode}"
                        ToolTip="{x:Static ps:Texts.AddBoundaryToolTip}"
                        Click="AddButton_Click"
                        Content="{DynamicResource {x:Static icons:IconKeys.ArrowSplitVertical}}" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding IsBoundaryMode}"
                        ToolTip="{x:Static ps:Texts.RemoveBoundaryToolTip}"
                        Click="RemoveButton_Click"
                        Content="{DynamicResource {x:Static icons:IconKeys.Eraser}}" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding IsBoundaryMode}"
                        ToolTip="{x:Static ps:Texts.ClearBoundariesToolTip}"
                        Click="ClearButton_Click"
                        Content="{DynamicResource {x:Static icons:IconKeys.DeleteSweep}}" />
                <Separator />
                <TextBlock Margin="4,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{Binding SummaryText}" />
            </ToolBar>
        </ToolBarTray>

        <RichTextBox x:Name="SourceText"
                     Grid.Row="2"
                     MinHeight="96"
                     MaxHeight="240"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="SourceText_PreviewKeyDown" />

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Content="{x:Static ps:Texts.Split}"
                    IsEnabled="{Binding CanSplit}"
                    Click="SplitButton_Click" />
            <Button Width="100"
                    Content="{x:Static loc:Texts.CancelButtonContent}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
