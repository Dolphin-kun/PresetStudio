                                <DataTemplate>
                                    <Border Margin="4,6,4,2"
                                            Padding="0,0,0,2"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                        <TextBlock Text="{Binding Name}"
