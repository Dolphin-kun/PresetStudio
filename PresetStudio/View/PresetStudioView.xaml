                    <ToolBar Height="26" Padding="0">
                        <Button Style="{StaticResource ToolBarButtonStyle}"
                                Command="{Binding RestoreTemplatesCommand}"
                                ToolTip="{x:Static ps:Texts.RestoreFromBackup}"
                                Content="{DynamicResource {x:Static icons:IconKeys.BackupRestore}}" />
                        <Separator />
                        <ToggleButton Style="{StaticResource ToolBarToggleButtonStyle}"
                                      IsChecked="{Binding IsPreviewOnly}"
                                      ToolTip="{x:Static ps:Texts.PreviewOnly}"
                                      Content="{DynamicResource {x:Static icons:IconKeys.ViewGrid}}" />
                        <Separator />
                        <view:SearchBox Text="{Binding TemplateSearchText}" />
                    </ToolBar>
                </ToolBarTray>

                <Border Grid.Row="1"
                        Padding="6,3"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        Visibility="{Binding HasTemplateWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Left"
                                        Style="{StaticResource MenuIconStyle}"
                                        Content="{DynamicResource {x:Static icons:IconKeys.AlertOutline}}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Right"
                                Content="{x:Static ps:Texts.RestoreEllipsis}"
                                Command="{Binding RestoreTemplatesCommand}"
                                Width="100"
                                Height="26"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0" />
                        <TextBlock Text="{Binding TemplateWarning}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ListBox Grid.Row="2"
                         Style="{StaticResource ThumbnailListStyle}"
                         PreviewMouseWheel="ThumbnailList_PreviewMouseWheel"
                         ScrollViewer.ScrollChanged="ThumbnailList_ScrollChanged"
                         IsVisibleChanged="ThumbnailList_IsVisibleChanged"
                         Loaded="ThumbnailList_Loaded"
                         ItemTemplate="{StaticResource ThumbnailTemplate}"
                         ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate}"
                         SelectionChanged="TemplateList_SelectionChanged"
                         ItemContainerStyle="{StaticResource TemplateItemStyle}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static ps:Texts.ChangeDefaultPreviewText}"
                                      Command="{Binding ChangePreviewTextCommand}">
                                <MenuItem.Icon>
                                    <ContentControl Style="{StaticResource MenuIconStyle}"
                                                    Content="{DynamicResource {x:Static icons:IconKeys.FormatText}}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
