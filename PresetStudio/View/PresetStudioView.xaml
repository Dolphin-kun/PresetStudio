<UserControl x:Class="PresetStudio.View.PresetStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ps="clr-namespace:PresetStudio"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:localization="clr-namespace:YukkuriMovieMaker.Resources.Localization;assembly=YukkuriMovieMaker.Plugin"
             xmlns:view="clr-namespace:PresetStudio.View"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ToolBarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolBarToggleButtonStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MenuIconStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="ThumbnailItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </Style>

        <Style x:Key="PreviewItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource ThumbnailItemStyle}">
            <EventSetter Event="MouseEnter" Handler="PreviewItem_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="PreviewItem_MouseLeave" />
        </Style>

        <Style x:Key="PresetItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource PreviewItemStyle}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.ApplyPartially}"
                                  IsEnabled="{Binding HasSelectedTextItem}"
                                  Tag="PartMenu">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FormatPaint}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static ps:Texts.Edit}"
                                  Command="{Binding EditPresetCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FileEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.OverwriteWithSelected}"
                                  Command="{Binding OverwritePresetCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.ContentSaveEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.ChangePreviewText}"
                                  Command="{Binding ChangePresetPreviewTextCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FormatText}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.Duplicate}"
                                  Command="{Binding DuplicatePresetCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.ContentCopy}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.MergePresets}"
                                  Command="{Binding MergePresetsCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.Group}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.EditCategoryName}"
                                  Command="{Binding EditCategoryCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.LayersEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.MoveForward}"
                                  Command="{Binding MoveVariantForwardCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.ArrowUp}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.MoveBackward}"
                                  Command="{Binding MoveVariantBackwardCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.ArrowDown}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.EditTags}"
                                  Command="{Binding EditTagsCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.TagEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.MoveToFolder}"
                                  Command="{Binding MovePresetCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FolderMove}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static ps:Texts.Delete}"
                                  Command="{Binding DeletePresetCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.Delete}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="PreviewMouseWheel" Handler="PresetItem_PreviewMouseWheel" />
            <EventSetter Event="ContextMenuOpening" Handler="PresetItem_ContextMenuOpening" />
        </Style>

        <Style x:Key="FolderItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource ThumbnailItemStyle}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.Open}"
                                  Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FolderOutline}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.RenameFolder}"
                                  Command="{Binding RenameFolderCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FolderEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static ps:Texts.Delete}"
                                  Command="{Binding DeleteFolderCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FolderRemove}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="MouseDoubleClick" Handler="FolderItem_MouseDoubleClick" />
        </Style>

        <Style x:Key="RuleItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource ThumbnailItemStyle}">
            <Setter Property="ToolTip" Value="{Binding Path}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.ApplyToSelected}"
                                  Command="{Binding RuleImages.ApplyCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.TransitionMasked}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static ps:Texts.Edit}"
                                  Command="{Binding RuleImages.EditCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FileEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.Delete}"
                                  Command="{Binding RuleImages.DeleteCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.Delete}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="MouseEnter" Handler="RuleItem_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="RuleItem_MouseLeave" />
            <EventSetter Event="MouseDoubleClick" Handler="RuleItem_MouseDoubleClick" />
        </Style>

        <Style x:Key="FacePartItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource ThumbnailItemStyle}">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="FacePartItem_PreviewMouseLeftButtonUp" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TachieItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource PreviewItemStyle}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.Apply}"
                                  Command="{Binding Tachie.ApplyCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.AccountCheck}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static ps:Texts.Rename}"
                                  Command="{Binding Tachie.RenameCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FileEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.Delete}"
                                  Command="{Binding Tachie.DeleteCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.Delete}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TachieItem_PreviewMouseLeftButtonUp" />
        </Style>

        <Style x:Key="FontItemStyle" TargetType="ListBoxItem">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.SetCategory}"
                                  Command="{Binding Fonts.EditCategoryCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.LayersEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.EditTags}"
                                  Command="{Binding Fonts.EditTagsCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.TagEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="FontItem_PreviewMouseLeftButtonUp" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TemplateItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource PreviewItemStyle}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.ShowFullCanvas}"
                                  Command="{Binding ToggleTemplateCanvasCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsChecked="{Binding PlacementTarget.DataContext.IsFullCanvas, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="{x:Static ps:Texts.SetInputFields}"
                                  Command="{Binding EditTemplateFieldsCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FormTextbox}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.RegisterAsTextPreset}"
                                  Command="{Binding RegisterTemplateAsPresetCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.TextBoxPlus}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="MouseDoubleClick" Handler="TemplateItem_MouseDoubleClick" />
        </Style>

        <Style x:Key="AudioEffectItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource ThumbnailItemStyle}">
            <Setter Property="ToolTip" Value="{Binding EffectListText}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.Edit}"
                                  Command="{Binding AudioEffects.EditTemplateCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FileEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.Delete}"
                                  Command="{Binding AudioEffects.DeleteTemplateCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.Delete}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AudioEffectItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="Loaded" Handler="AudioEffectItem_Loaded" />
        </Style>

        <DataTemplate x:Key="AudioThumbnailTemplate">
            <Grid Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  Margin="4"
                  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="Black">
                    <Grid>
                        <view:WaveformView Margin="6,10"
                                           Peaks="{Binding Peaks}"
                                           Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,4,4,6"
                           Visibility="{Binding DataContext.ShowsLabels, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="EffectItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource PreviewItemStyle}">
            <Setter Property="ToolTip" Value="{Binding EffectListText}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static ps:Texts.Edit}"
                                  Command="{Binding EditEffectTemplateCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.FileEdit}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static ps:Texts.Delete}"
                                  Command="{Binding DeleteEffectTemplateCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ContentControl Style="{StaticResource MenuIconStyle}"
                                                Content="{DynamicResource {x:Static icons:IconKeys.Delete}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="MouseDoubleClick" Handler="EffectItem_MouseDoubleClick" />
        </Style>

        <DataTemplate x:Key="ThumbnailTemplate">
            <Grid Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  Margin="4"
                  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPreviewOnly, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Image Source="{Binding PreviewImage}"
                       Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Stretch="Uniform" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,4,4,6"
                           Visibility="{Binding DataContext.ShowsLabels, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="FavoriteStarStyle" TargetType="controls:FavoriteButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ToolTip" Value="{x:Static localization:Texts.FavoriteButtonToolTip}" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PresetThumbnailTemplate">
            <Grid Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  Margin="4"
                  Background="Transparent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPreviewOnly, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                <Setter Property="ToolTip" Value="{Binding NameToolTipText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Source="{Binding Current.PreviewImage}"
                       Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Stretch="Uniform" />
                <controls:FavoriteButton Style="{StaticResource FavoriteStarStyle}"
                                         IsChecked="{Binding IsFavorite}"
                                         Click="FavoriteButton_Click" />
                <StackPanel Grid.Row="1"
                            Visibility="{Binding DataContext.ShowsLabels, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding DisplayName}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,4,4,0" />
                    <TextBlock Text="{Binding TagText}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,0,4,0"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FolderTemplate">
            <Grid Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  Margin="4"
                  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Width="{Binding DataContext.FolderIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Height="{Binding DataContext.FolderIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                Content="{DynamicResource {x:Static icons:IconKeys.Folder}}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,4,4,6" />
            </Grid>
        </DataTemplate>

        <view:PresetEntryStyleSelector x:Key="PresetEntryStyleSelector"
                                       FolderStyle="{StaticResource FolderItemStyle}"
                                       PresetStyle="{StaticResource PresetItemStyle}" />

        <view:PresetEntryTemplateSelector x:Key="PresetEntryTemplateSelector"
                                          FolderTemplate="{StaticResource FolderTemplate}"
                                          PresetTemplate="{StaticResource PresetThumbnailTemplate}" />

        <Style x:Key="ThumbnailListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
