<Window x:Class="PresetStudio.View.RuleImageEditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ps="clr-namespace:PresetStudio"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" />
    </Window.Style>

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Grid.Column="0"
               Width="240"
               Height="240"
               Source="{Binding Preview}" />

        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static ps:Texts.NameLabel}" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="NameBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Text="{x:Static ps:Texts.Shape}" Style="{StaticResource LabelStyle}" />
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding Shapes}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding Shape}" />

            <TextBlock Grid.Row="2" Text="{x:Static ps:Texts.Angle}" Style="{StaticResource LabelStyle}" />
            <Slider Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="360"
                    TickFrequency="15"
                    IsSnapToTickEnabled="True"
                    IsEnabled="{Binding IsAngleEnabled}"
                    Value="{Binding Angle}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Angle, StringFormat={}{0:0}°}" Style="{StaticResource ValueStyle}" />

            <TextBlock Grid.Row="3" Text="{x:Static ps:Texts.Divisions}" Style="{StaticResource LabelStyle}" />
            <Slider Grid.Row="3"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="1"
                    Maximum="64"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    IsEnabled="{Binding IsCountEnabled}"
                    Value="{Binding Count}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Count}" Style="{StaticResource ValueStyle}" />

            <TextBlock Grid.Row="4" Text="{x:Static ps:Texts.Noise}" Style="{StaticResource LabelStyle}" />
            <Slider Grid.Row="4"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding Noise}" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Noise, StringFormat={}{0:0}%}" Style="{StaticResource ValueStyle}" />

            <TextBlock Grid.Row="5" Text="{x:Static ps:Texts.Seed}" Style="{StaticResource LabelStyle}" />
            <Slider Grid.Row="5"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="1"
                    Maximum="100"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    IsEnabled="{Binding IsSeedEnabled}"
                    Value="{Binding Seed}" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Seed}" Style="{StaticResource ValueStyle}" />

            <CheckBox Grid.Row="6"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      VerticalAlignment="Center"
                      Content="{x:Static ps:Texts.Invert}"
                      IsChecked="{Binding IsInverted}" />
        </Grid>

        <Button Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Width="100"
                Content="{x:Static ps:Texts.Save}"
                IsEnabled="{Binding CanSubmit}"
                Click="SaveButton_Click" />
    </Grid>
</Window>
