<Window x:Class="PresetStudio.View.TagInputWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:YukkuriMovieMaker.Resources.Localization;assembly=YukkuriMovieMaker.Plugin"
        Width="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=TagBox}"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" />
    </Window.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBox x:Name="TagBox"
                     VerticalContentAlignment="Center"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TagBox_TextChanged" />
            <TextBlock Text="{Binding PlaceHolder}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=TagBox}" Value="" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TagBox}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Popup PlacementTarget="{Binding ElementName=TagBox}"
                   Placement="Bottom"
                   StaysOpen="False"
                   Width="{Binding ActualWidth, ElementName=TagBox}"
                   IsOpen="{Binding IsSuggestionOpen, Mode=TwoWay}">
                <ListBox x:Name="SuggestionList"
                         MaxHeight="160"
                         Focusable="False"
                         ItemsSource="{Binding Suggestions}"
                         PreviewMouseLeftButtonUp="SuggestionList_PreviewMouseLeftButtonUp" />
            </Popup>
        </Grid>

        <Button Grid.Row="1"
                HorizontalAlignment="Right"
                Width="100"
                Content="{x:Static loc:Texts.OKButtonContent}"
                Click="OkButton_Click" />
    </Grid>
</Window>
